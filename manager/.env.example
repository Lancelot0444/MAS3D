# Copia este archivo como .env.local (desarrollo) o configura estas variables en Vercel.
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...clave-anon-publica...
# Clave secreta de servicio: SOLO en el servidor (nunca con prefijo NEXT_PUBLIC). Se usa para invitar usuarios.
SUPABASE_SERVICE_ROLE_KEY=eyJ...clave-service-role...
# Dirección pública de la app (para enlaces de invitación y Google)
NEXT_PUBLIC_SITE_URL=https://app.mas3d.ec
