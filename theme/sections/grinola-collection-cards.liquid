{% render 'grinola-motion' %}

<section class="g-scope g-cc">
  <div class="g-wrap">
    {%- if section.settings.heading != blank -%}
      <h2 class="g-title g-cc__heading" data-g-reveal>{{ section.settings.heading }}</h2>
    {%- endif -%}
    <div class="g-cc__track" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign collection_ref = block.settings.collection
          assign card_title = block.settings.title | default: collection_ref.title
          assign card_image = block.settings.image | default: collection_ref.featured_image
          assign card_url = collection_ref.url | default: routes.collections_url
        -%}
        <a
          class="g-card g-cc__card"
          href="{{ card_url }}"
          role="listitem"
          data-g-reveal
          style="--g-delay: {{ forloop.index0 | times: 110 }}ms; --g-tint: {{ block.settings.tint }}"
          {{ block.shopify_attributes }}
        >
          <div class="g-cc__media">
            {%- if card_image -%}
              {{
                card_image
                | image_url: width: 1100
                | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 33vw, 82vw', widths: '400, 700, 1100', alt: card_title
              }}
            {%- else -%}
              <div class="g-cc__placeholder">{% render 'grinola-icon', name: 'leaf' %}</div>
            {%- endif -%}
          </div>
          <div class="g-cc__body">
            <h3 class="g-title g-cc__title">{{ card_title }}</h3>
            {%- if block.settings.subtitle != blank -%}
              <p class="g-cc__subtitle">{{ block.settings.subtitle }}</p>
            {%- endif -%}
            <span class="g-link g-cc__cta">
              {{- block.settings.link_label -}}
              {% render 'grinola-icon', name: 'arrow' %}
            </span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .g-cc {
    padding-block: 28px;
  }
  .g-cc__heading {
    font-size: clamp(1.8rem, 5vw, 2.6rem);
    margin-bottom: 20px;
  }
  .g-cc__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 82%;
    gap: 14px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding-bottom: 4px;
  }
  .g-cc__track::-webkit-scrollbar {
    display: none;
  }
  .g-cc__card {
    position: relative;
    display: block;
    min-height: 220px;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    scroll-snap-align: start;
    border: 1px solid var(--g-line);
    border-radius: 6px;
    color: var(--g-ivory);
    text-decoration: none;
    background: linear-gradient(120deg, var(--g-tint, #1e2b1f) 0%, #111310 70%);
    transition: border-color 0.5s var(--g-ease), transform 0.5s var(--g-ease);
  }
  .g-cc__media {
    position: absolute;
    inset: 0 0 0 38%;
  }
  .g-cc__media img,
  .g-cc__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.1s var(--g-ease);
  }
  .g-cc__placeholder {
    display: grid;
    place-items: center;
    padding: 18%;
    color: rgba(201, 176, 122, 0.35);
  }
  .g-cc__card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(17, 19, 16, 0.92) 0%, rgba(17, 19, 16, 0.55) 45%, rgba(17, 19, 16, 0) 75%);
    pointer-events: none;
  }
  .g-cc__body {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    height: 100%;
    max-width: 62%;
    padding: 22px;
  }
  .g-cc__title {
    font-size: clamp(1.5rem, 4vw, 2rem);
  }
  .g-cc__subtitle {
    margin: 10px 0 0;
    font-size: 0.7rem;
    letter-spacing: 0.22em;
    line-height: 1.7;
    text-transform: uppercase;
    color: var(--g-muted);
  }
  .g-cc__cta {
    margin-top: auto;
    align-self: flex-start;
  }
  @media (hover: hover) and (pointer: fine) {
    .g-cc__card:hover {
      border-color: var(--g-gold);
      transform: translateY(-4px);
    }
    .g-cc__card:hover .g-cc__media img {
      transform: scale(1.07);
    }
    .g-cc__card:hover .g-cc__cta svg {
      transform: translateX(4px);
    }
  }
  @media (min-width: 990px) {
    .g-cc__track {
      grid-auto-flow: row;
      grid-template-columns: repeat(var(--g-cols, 3), 1fr);
      overflow: visible;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "GRINOLA · Colecciones",
  "tag": "div",
  "class": "g-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título (opcional)" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Colección",
      "limit": 6,
      "settings": [
        { "type": "collection", "id": "collection", "label": "Colección" },
        { "type": "text", "id": "title", "label": "Título (si quieres cambiarlo)" },
        { "type": "text", "id": "subtitle", "label": "Bajada", "default": "Diseños coleccionables" },
        { "type": "image_picker", "id": "image", "label": "Imagen (si no, usa la de la colección)" },
        { "type": "color", "id": "tint", "label": "Color de fondo", "default": "#1E2B1F" },
        { "type": "text", "id": "link_label", "label": "Texto del enlace", "default": "Ver colección" }
      ]
    }
  ],
  "presets": [
    {
      "name": "GRINOLA · Colecciones",
      "blocks": [
        { "type": "card", "settings": { "subtitle": "Piezas de uso diario" } },
        { "type": "card", "settings": { "subtitle": "Tiradas cortas y bajo pedido", "tint": "#2A2418" } },
        { "type": "card", "settings": { "subtitle": "Diseño dulce", "tint": "#3A1E28" } }
      ]
    }
  ]
}
{% endschema %}
