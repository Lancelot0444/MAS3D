{% render 'grinola-motion' %}

{%- liquid
  assign p = product
  assign mf = p.metafields.custom
  assign features = mf.caracteristicas.value
  assign detail_media = p.media[1] | default: p.featured_media
-%}

{%- if p -%}
  <section class="g-scope g-pd" data-g-tilt-area>
    <div class="g-wrap g-pd__grid">
      <div class="g-pd__copy" data-g-reveal>
        {%- if section.settings.eyebrow != blank -%}
          <p class="g-eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2 class="g-title g-pd__title">{{ section.settings.heading }}</h2>

        {%- if features != blank -%}
          <ul class="g-pd__features" role="list">
            {%- for feature in features -%}
              <li>
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.3"/>
                  <path d="M8 12.5l2.6 2.5L16 9.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
                {{ feature }}
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        <dl class="g-pd__specs">
          {%- if mf.material.value != blank -%}
            <div><dt>{{ section.settings.label_material }}</dt><dd>{{ mf.material.value }}</dd></div>
          {%- endif -%}
          {%- if mf.dimensiones.value != blank -%}
            <div><dt>{{ section.settings.label_dimensions }}</dt><dd>{{ mf.dimensiones.value }}</dd></div>
          {%- endif -%}
          {%- if mf.peso.value != blank -%}
            <div><dt>{{ section.settings.label_weight }}</dt><dd>{{ mf.peso.value }}</dd></div>
          {%- endif -%}
          {%- if mf.tiempo_preparacion.value != blank -%}
            <div><dt>{{ section.settings.label_lead_time }}</dt><dd>{{ mf.tiempo_preparacion.value }}</dd></div>
          {%- endif -%}
          {%- if mf.unidades_edicion.value != blank -%}
            <div><dt>{{ section.settings.label_edition }}</dt><dd>{{ mf.unidades_edicion.value }}</dd></div>
          {%- endif -%}
        </dl>

        {%- if mf.cuidados.value != blank -%}
          <div class="g-pd__care">
            <h3>{{ section.settings.label_care }}</h3>
            <p>{{ mf.cuidados.value | newline_to_br }}</p>
          </div>
        {%- endif -%}
      </div>

      <div class="g-pd__media" data-g-reveal="zoom" style="--g-delay: 150ms">
        {%- if detail_media -%}
          <div data-g-tilt="8">
            {{
              detail_media
              | image_url: width: 1200
              | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 45vw, 92vw', widths: '500, 800, 1200', class: 'g-pd__img'
            }}
          </div>
        {%- endif -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% stylesheet %}
  .g-pd {
    padding-block: 56px;
    background: radial-gradient(90% 80% at 80% 50%, #1e2b1f 0%, #111310 70%);
  }
  .g-pd__grid {
    display: grid;
    gap: 32px;
    align-items: center;
  }
  .g-pd__title {
    font-size: clamp(2rem, 6vw, 2.8rem);
  }
  .g-pd__features {
    display: grid;
    gap: 10px;
    margin: 22px 0 0;
    padding: 0;
    list-style: none;
  }
  .g-pd__features li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.95rem;
  }
  .g-pd__features svg {
    flex: none;
    width: 20px;
    height: 20px;
    color: var(--g-gold);
  }
  .g-pd__specs {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    margin: 26px 0 0;
    border: 1px solid var(--g-line);
    background: var(--g-line);
  }
  .g-pd__specs div {
    padding: 12px 14px;
    background: var(--g-carbon-2);
  }
  .g-pd__specs dt {
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--g-gold);
  }
  .g-pd__specs dd {
    margin: 4px 0 0;
    font-size: 0.95rem;
  }
  .g-pd__care {
    margin-top: 22px;
    color: var(--g-muted);
    font-size: 0.9rem;
    line-height: 1.6;
  }
  .g-pd__care h3 {
    margin: 0 0 6px;
    font-family: var(--font-body--family);
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--g-ivory);
  }
  .g-pd__care p {
    margin: 0;
  }
  .g-pd__img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 6px;
    border: 1px solid var(--g-line);
  }
  @media (min-width: 990px) {
    .g-pd__grid {
      grid-template-columns: 1fr 1fr;
      gap: 64px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "GRINOLA · Detalles",
  "tag": "div",
  "class": "g-section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto superior", "default": "Detalles que marcan la diferencia" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Materiales y diseño" },
    { "type": "text", "id": "label_material", "label": "Etiqueta material", "default": "Material" },
    { "type": "text", "id": "label_dimensions", "label": "Etiqueta medidas", "default": "Medidas" },
    { "type": "text", "id": "label_weight", "label": "Etiqueta peso", "default": "Peso" },
    { "type": "text", "id": "label_lead_time", "label": "Etiqueta preparación", "default": "Preparación" },
    { "type": "text", "id": "label_edition", "label": "Etiqueta unidades", "default": "Unidades de la edición" },
    { "type": "text", "id": "label_care", "label": "Etiqueta cuidados", "default": "Cuidados" }
  ],
  "presets": [{ "name": "GRINOLA · Detalles" }]
}
{% endschema %}
