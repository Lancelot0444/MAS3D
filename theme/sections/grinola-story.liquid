{% render 'grinola-motion' %}

<section class="g-scope g-story" data-g-tilt-area>
  {%- if section.settings.image -%}
    <div class="g-story__bg" aria-hidden="true">
      {{ section.settings.image | image_url: width: 2000 | image_tag: loading: 'lazy', sizes: '100vw', widths: '750, 1200, 2000', alt: '' }}
    </div>
  {%- endif -%}
  <div class="g-wrap g-story__grid">
    <div data-g-reveal>
      {%- if section.settings.eyebrow != blank -%}
        <p class="g-eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="g-title g-story__title">{{ section.settings.heading }}</h2>
    </div>
    <div class="g-story__text" data-g-reveal style="--g-delay: 120ms">{{ section.settings.text }}</div>
    {%- if section.settings.button_label != blank -%}
      <div data-g-reveal style="--g-delay: 220ms">
        <a class="g-btn g-btn--ghost" href="{{ section.settings.button_link | default: routes.root_url }}">
          {{- section.settings.button_label -}}
          {% render 'grinola-icon', name: 'arrow' %}
        </a>
      </div>
    {%- endif -%}
    <div class="g-story__mark" data-g-tilt="14" aria-hidden="true">
      {%- if section.settings.mark -%}
        {{ section.settings.mark | image_url: width: 500 | image_tag: loading: 'lazy', alt: '' }}
      {%- else -%}
        {% render 'grinola-icon', name: 'leaf' %}
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .g-story {
    padding-block: 56px;
    border-block: 1px solid var(--g-line);
    background: linear-gradient(100deg, #111310 0%, #18211a 60%, #1e2b1f 100%);
  }
  .g-story__bg {
    position: absolute;
    inset: 0;
    opacity: 0.25;
  }
  .g-story__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .g-story__grid {
    position: relative;
    display: grid;
    gap: 22px;
    align-items: center;
  }
  .g-story__title {
    font-size: clamp(2.2rem, 7vw, 3.4rem);
  }
  .g-story__text {
    max-width: 58ch;
    color: var(--g-muted);
    line-height: 1.7;
  }
  .g-story__text p {
    margin: 0;
  }
  .g-story__mark {
    display: none;
    width: 160px;
    color: var(--g-gold);
  }
  .g-story__mark img {
    width: 100%;
    height: auto;
  }
  @media (min-width: 990px) {
    .g-story__grid {
      grid-template-columns: auto 1fr auto auto;
      gap: 48px;
    }
    .g-story__mark {
      display: block;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "GRINOLA · Historia",
  "tag": "div",
  "class": "g-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto superior", "default": "Más que objetos" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Quiénes somos" },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texto",
      "default": "<p>GRINOLA fabrica piezas funcionales y coleccionables con impresión 3D en Ecuador. Diseño, función y carácter en cada objeto.</p>"
    },
    { "type": "text", "id": "button_label", "label": "Botón", "default": "Conoce nuestra historia" },
    { "type": "url", "id": "button_link", "label": "Enlace del botón" },
    { "type": "image_picker", "id": "image", "label": "Imagen de fondo (opcional)" },
    { "type": "image_picker", "id": "mark", "label": "Isotipo de hojas (PNG)" }
  ],
  "presets": [{ "name": "GRINOLA · Historia" }]
}
{% endschema %}
