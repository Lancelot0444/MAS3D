# ============================================
# JARVIS - Configuration
# ============================================
# Copy this file to .env and fill in your values

# --- Twilio (WhatsApp) ---
# Get these from https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Your personal WhatsApp number (with country code, no spaces)
# Example: whatsapp:+56912345678
YOUR_WHATSAPP_NUMBER=whatsapp:+XXXXXXXXXXX

# --- Anthropic Claude ---
# Get from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# --- App Settings ---
PORT=3000
# Timezone for reminders (https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
TIMEZONE=America/Santiago

# --- Your name (Jarvis will use it) ---
YOUR_NAME=Jefe
